    "QuiX is not running in the meantime — macOS wakes it when the camera arrives. The match only recognises the HERO12 Black.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuiX ne tourne pas en attendant : c'est macOS qui le réveille au branchement. L'appariement ne reconnaît que la HERO12 Black."
          }
        }
      }
    },
