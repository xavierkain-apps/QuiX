            "value": "Tout"
          }
        }
      }
    },
    "All %lld clips on the camera are present on this Mac, verified one by one. They will be erased from the card and cannot be recovered.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The %lld clip on the camera is present on this Mac, verified. It will be erased from the card and cannot be recovered."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All %lld clips on the camera are present on this Mac, verified one by one. They will be erased from the card and cannot be recovered."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Le clip de la caméra est présent sur ce Mac, vérifié. Il sera effacé de la carte et ne pourra pas être récupéré."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les %lld clips de la caméra sont tous présents sur ce Mac, vérifiés un par un. Ils seront effacés de la carte et ne pourront pas être récupérés."
                }
              }
            }
          }
        }
      }
    },
